# Credenciales de INFILE (ambiente de pruebas) para los tests de integración.
# Copia este archivo a .env y llena los valores. Sin credenciales, los tests
# de integración se saltan y solo corren los tests unitarios.
FEL_PROVIDER=infile
FEL_USERNAME=
# NIT del emisor según el certificado de firma de las credenciales (los tests
# de integración lo usan como NIT del emisor en los XML):
FEL_ISSUER_NIT=
FEL_LLAVE_FIRMA=
FEL_LLAVE_API=
# Nombres legados (fallback de FEL_LLAVE_FIRMA / FEL_LLAVE_API):
FEL_KEY=
FEL_PASSWORD=
FEL_BASE_URL=https://certificador.feel.com.gt/fel/procesounificado/transaccion/v2/xml
FEL_CERTIFY_URL=https://certificador.feel.com.gt/fel/procesounificado/transaccion/v2/xml
FEL_CANCEL_URL=https://certificador.feel.com.gt/fel/procesounificado/transaccion/v2/xml
FEL_STATUS_URL=
FEL_TIMEOUT=30
FEL_VERIFY_SSL=true
