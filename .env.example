# Credenciales de INFILE (ambiente de pruebas) para los tests de integración.
# Copia este archivo a .env y llena los valores. Sin credenciales, los tests
# de integración se saltan y solo corren los tests unitarios.
FEL_PROVIDER=infile
FEL_USERNAME=
# NIT del emisor según el certificado de firma de las credenciales (los tests
# de integración lo usan como NIT del emisor en los XML):
FEL_ISSUER_NIT=
FEL_LLAVE_FIRMA=
FEL_LLAVE_API=
# Nombres legados (fallback de FEL_LLAVE_FIRMA / FEL_LLAVE_API):
FEL_KEY=
FEL_PASSWORD=
FEL_BASE_URL=https://certificador.feel.com.gt/fel/procesounificado/transaccion/v2/xml
FEL_CERTIFY_URL=https://certificador.feel.com.gt/fel/procesounificado/transaccion/v2/xml
FEL_CANCEL_URL=https://certificador.feel.com.gt/fel/procesounificado/transaccion/v2/xml
FEL_STATUS_URL=
FEL_TIMEOUT=30
FEL_VERIFY_SSL=true

# Datos del emisor de pruebas (equivalen a una fila de `bill_issuers`:
# name, commercial_name, email, office_code, iva_affiliation, address,
# postal_code, city, state, country, phrase_type, phrase_stage,
# person_type, default_document_type). Los tests de integración construyen
# el FelIssuer con estos valores.
FEL_ISSUER_NAME=
FEL_ISSUER_COMMERCIAL_NAME=
FEL_ISSUER_EMAIL=
FEL_ISSUER_OFFICE_CODE=1
FEL_ISSUER_IVA_AFFILIATION=GEN
FEL_ISSUER_ADDRESS=
FEL_ISSUER_POSTAL_CODE=01001
FEL_ISSUER_CITY=Guatemala
FEL_ISSUER_STATE=Guatemala
FEL_ISSUER_COUNTRY=GT
FEL_ISSUER_PHRASE_TYPE=1
FEL_ISSUER_PHRASE_STAGE=1
FEL_ISSUER_PERSON_TYPE=
FEL_ISSUER_DEFAULT_DOCUMENT_TYPE=FACT
