{
  "name": "schoolaid/fel",
  "description": "Paquete Laravel para generar facturas electrónicas FEL de Guatemala",
  "type": "library",
  "require": {
    "php": "^8.3",
    "illuminate/support": "12.x-dev",
    "illuminate/http": "12.x-dev",
    "illuminate/console": "12.x-dev",
    "guzzlehttp/guzzle": "^7.8.2",
    "ext-xmlwriter": "*",
    "ext-dom": "*"
  },
  "require-dev": {
    "orchestra/testbench": "10.x-dev",
    "pestphp/pest": "3.x-dev"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Schoolaid\\Fel\\": "src/",
      "Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "schoolaid",
      "email": "hsinglic@gmail.com"
    }
  ],
  "minimum-stability": "dev",
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
